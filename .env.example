# Copy to backend/.env (optional; all values have working defaults). No API keys are required.
FIN04_DATABASE_URL=sqlite:///./fin04.db
FIN04_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIN04_LOG_LEVEL=INFO
FIN04_MAX_MONTE_CARLO_RUNS=5000
# Frontend (frontend/.env.local), only if the backend is not on 127.0.0.1:8000
# VITE_BACKEND_URL=http://127.0.0.1:8000
