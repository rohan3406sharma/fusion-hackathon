# Copy to backend/.env (optional; all values have working defaults). No API keys are required.
FIN04_DATABASE_URL=sqlite:///./fin04.db
FIN04_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIN04_LOG_LEVEL=INFO
FIN04_MAX_MONTE_CARLO_RUNS=5000
# Frontend (frontend/.env.local), only if the backend is not on 127.0.0.1:8000
# VITE_BACKEND_URL=http://127.0.0.1:8000

# AI Climate Risk Copilot (optional). Default: local Ollama with qwen3:8b; deterministic templates are always the fallback.
# FIN04_LLM_PROVIDER=ollama            # ollama | anthropic | deterministic
# FIN04_OLLAMA_URL=http://127.0.0.1:11434
# FIN04_OLLAMA_MODEL=qwen3:8b
# FIN04_LLM_TIMEOUT_S=90
# Paid, optional, off unless you set both lines (key stays on the server, never in the browser):
# FIN04_LLM_PROVIDER=anthropic
# FIN04_ANTHROPIC_API_KEY=
# FIN04_ANTHROPIC_MODEL=claude-haiku-5-5
